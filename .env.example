# Runtime
NODE_ENV=development
APP_PORT=3040
FRONTEND_ORIGIN=http://localhost:6173
# Keep VITE_PORT aligned with FRONTEND_ORIGIN when changing frontend ports.
VITE_PORT=6173
# Frontend calls backend APIs directly; no Vite dev proxy is used.
VITE_API_BASE_URL=http://localhost:3040

# Database / Redis
DATABASE_URL=postgres://wolf:wolf@localhost:5432/wolf
REDIS_URL=redis://localhost:6379

# Security
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_COOKIE_NAME=wolf_session
SESSION_TTL_DAYS=30

# Background jobs
DRY_RUN_SCHEDULER_ENABLED=false
DRY_RUN_MORNING_TIME_IST=08:45
DRY_RUN_EOD_TIME_IST=15:35
GTT_REVALIDATION_SCHEDULER_ENABLED=false
GTT_REVALIDATION_INTERVAL_MINUTES=60

# Optional provider defaults; user-specific secrets are stored encrypted via settings APIs.
KITE_API_KEY=
KITE_API_SECRET=
EXA_API_KEY=
FINNHUB_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_SMALL_MODEL=
OPENAI_COMPATIBLE_MEDIUM_MODEL=
OPENAI_COMPATIBLE_BIG_MODEL=
